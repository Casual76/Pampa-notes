{
  "name": "pampa-notes-sync",
  "private": true,
  "version": "0.1.0",
  "description": "L'indice in cloud di Pampa Notes: un Worker Cloudflare con D1. Solo testo, mai file.",
  "scripts": {
    "dev": "wrangler dev --local --ip 0.0.0.0 --port 8787",
    "schema:local": "wrangler d1 execute pampa-notes --local --file=./schema.sql",
    "schema:remote": "wrangler d1 execute pampa-notes --remote --file=./schema.sql",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
